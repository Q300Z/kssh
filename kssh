# @description Récupère un mot de passe ou attribut d'une entrée KeePassXC
kp_get_attribute() {
    local entry_path="$1"
    local attribute="${2:-password}"
    local master_pwd="${3:-}"

    # Garde-fou : pas d'exécution sans mot de passe maître ni fichier de clé
    if [ -z "$master_pwd" ] && { [ -z "$KEEPASS_KEYFILE" ] || [ ! -f "$KEEPASS_KEYFILE" ]; }; then
        return 1
    fi

    local clean_path="${entry_path#/}"
    local kp_args=("-q" "-s" "-a" "$attribute")
    [ -n "$KEEPASS_KEYFILE" ] && [ -f "$KEEPASS_KEYFILE" ] && kp_args+=("-k" "$KEEPASS_KEYFILE")

    local kp_out="" kp_status=1
    for p in "$clean_path" "$entry_path"; do
        [ -z "$p" ] && continue
        if [ -n "$master_pwd" ]; then
            kp_out=$(printf '%s\n' "$master_pwd" | keepassxc-cli show "${kp_args[@]}" -- "$KEEPASS_DB" "$p" 2>/dev/null) && kp_status=0 || kp_status=$?
        else
            kp_out=$(keepassxc-cli show "${kp_args[@]}" -- "$KEEPASS_DB" "$p" 2>/dev/null) && kp_status=0 || kp_status=$?
        fi
        if [ "$kp_status" -eq 0 ] && [ -n "$kp_out" ]; then
            printf '%s' "$kp_out"
            return 0
        fi
        [ "$kp_status" -ne 0 ] && log_debug "kp_get_attribute($attribute, $p) -> code $kp_status"
    done
    return 1
}

# @description Liste les pièces jointes d'une entrée KeePassXC
kp_get_attachments() {
    local entry_path="$1"
    local master_pwd="${2:-}"

    # Garde-fou : pas d'exécution sans mot de passe maître ni fichier de clé
    if [ -z "$master_pwd" ] && { [ -z "$KEEPASS_KEYFILE" ] || [ ! -f "$KEEPASS_KEYFILE" ]; }; then
        return 1
    fi

    local clean_path="${entry_path#/}"
    local kp_args=("-q" "--show-attachments")
    [ -n "$KEEPASS_KEYFILE" ] && [ -f "$KEEPASS_KEYFILE" ] && kp_args+=("-k" "$KEEPASS_KEYFILE")

    local kp_out="" kp_status=1
    for p in "$clean_path" "$entry_path"; do
        [ -z "$p" ] && continue
        if [ -n "$master_pwd" ]; then
            kp_out=$(printf '%s\n' "$master_pwd" | keepassxc-cli show "${kp_args[@]}" -- "$KEEPASS_DB" "$p" 2>/dev/null) && kp_status=0 || kp_status=$?
        else
            kp_out=$(keepassxc-cli show "${kp_args[@]}" -- "$KEEPASS_DB" "$p" 2>/dev/null) && kp_status=0 || kp_status=$?
        fi
        if [ "$kp_status" -eq 0 ] && [ -n "$kp_out" ]; then
            printf '%s' "$kp_out"
            return 0
        fi
        [ "$kp_status" -ne 0 ] && log_debug "kp_get_attachments($p) -> code $kp_status"
    done
    return 1
}

# @description Recherche les entrées correspondant à un terme d'URL ou d'hôte
kp_search_entries() {
    local term="$1"
    local master_pwd="${2:-}"

    # Garde-fou : pas d'exécution sans mot de passe maître ni fichier de clé
    if [ -z "$master_pwd" ] && { [ -z "$KEEPASS_KEYFILE" ] || [ ! -f "$KEEPASS_KEYFILE" ]; }; then
        return 1
    fi

    local kp_args=("-q")
    [ -n "$KEEPASS_KEYFILE" ] && [ -f "$KEEPASS_KEYFILE" ] && kp_args+=("-k" "$KEEPASS_KEYFILE")

    local kp_out="" kp_status=1
    if [ -n "$master_pwd" ]; then
        kp_out=$(printf '%s\n' "$master_pwd" | keepassxc-cli search "${kp_args[@]}" -- "$KEEPASS_DB" "$term" 2>/dev/null) && kp_status=0 || kp_status=$?
    else
        kp_out=$(keepassxc-cli search "${kp_args[@]}" -- "$KEEPASS_DB" "$term" 2>/dev/null) && kp_status=0 || kp_status=$?
    fi
    if [ "$kp_status" -eq 0 ]; then
        printf '%s\n' "$kp_out"
        return 0
    fi
    log_debug "kp_search_entries($term) -> code $kp_status"
    return 1
}

# @description Exporte une pièce jointe (clé SSH) vers un fichier temporaire sécurisé
kp_export_attachment() {
    local entry_path="$1"
    local att_name="$2"
    local dest_file="$3"
    local master_pwd="${4:-}"

    # Garde-fou : pas d'exécution sans mot de passe maître ni fichier de clé
    if [ -z "$master_pwd" ] && { [ -z "$KEEPASS_KEYFILE" ] || [ ! -f "$KEEPASS_KEYFILE" ]; }; then
        return 1
    fi

    local clean_path="${entry_path#/}"
    local kp_args=("-q")
    [ -n "$KEEPASS_KEYFILE" ] && [ -f "$KEEPASS_KEYFILE" ] && kp_args+=("-k" "$KEEPASS_KEYFILE")

    touch "$dest_file" && chmod 600 "$dest_file"
    local kp_err=""
    for p in "$clean_path" "$entry_path"; do
        [ -z "$p" ] && continue
        if [ -n "$master_pwd" ]; then
            kp_err=$(printf '%s\n' "$master_pwd" | keepassxc-cli attachment-export "${kp_args[@]}" -- "$KEEPASS_DB" "$p" "$att_name" "$dest_file" 2>&1) || true
        else
            kp_err=$(keepassxc-cli attachment-export "${kp_args[@]}" -- "$KEEPASS_DB" "$p" "$att_name" "$dest_file" 2>&1) || true
        fi
        [ -s "$dest_file" ] && return 0
        [ -n "$kp_err" ] && log_debug "kp_export_attachment($p, $att_name) -> $kp_err"
    done
    return 1
}

# @description Crée un fichier temporaire sécurisé pour clé SSH extraite (RAM volatile uniquement, sans /tmp sauf override)
creer_fichier_cle_temporaire() {
    local tmp_key=""
    if [ -d /dev/shm ] && [ -w /dev/shm ]; then
        tmp_key=$(mktemp /dev/shm/kssh_key.XXXXXX)
    elif [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -d "$XDG_RUNTIME_DIR" ] && [ -w "$XDG_RUNTIME_DIR" ]; then
        tmp_key=$(mktemp "${XDG_RUNTIME_DIR}/kssh_key.XXXXXX")
    elif [ "${KSSH_ALLOW_TMP_KEY:-false}" = "true" ]; then
        tmp_key=$(mktemp /tmp/kssh_key.XXXXXX)
    else
        log_error "Aucun répertoire RAM volatile (/dev/shm ou XDG_RUNTIME_DIR) disponible pour extraire la clé temporaire."
        return 1
    fi
    chmod 600 "$tmp_key"
    printf '%s' "$tmp_key"
}

# @description Extrait hôte et port exacts d'une URL KeePassXC et compare à RESOLVED_HOST / RESOLVED_PORT
url_correspond_cible() {
    local entry_url="$1"
    local expected_host="$2"
    local expected_port="${3:-22}"
    [ -z "$entry_url" ] && return 1

    # Retirer le schéma éventuel (ssh://, sftp://, etc.) et le chemin final
    local rest="${entry_url#*://}"
    rest="${rest%%/*}"
    # Retirer user@ éventuel
    rest="${rest#*@}"

    local u_host="" u_port=""
    if [[ "$rest" =~ ^\[([a-fA-F0-9:]+)\](:([0-9]+))?$ ]]; then
        u_host="${BASH_REMATCH[1]}"
        u_port="${BASH_REMATCH[3]}"
    elif [[ "$rest" =~ ^([^:]+)(:([0-9]+))?$ ]]; then
        u_host="${BASH_REMATCH[1]}"
        u_port="${BASH_REMATCH[3]}"
    else
        return 1
    fi

    [ "$u_host" != "$expected_host" ] && return 1
    if [ -n "$u_port" ] && [ -n "$expected_port" ] && [ "$u_port" != "$expected_port" ]; then
        return 1
    fi
    return 0
}

# ==============================================================================
# [07] GESTION DE LA CONFIGURATION OPENSSH (~/.ssh/config)
# ==============================================================================

lister_serveurs() {
    printf '%b%b=== Serveurs configurés dans ~/.ssh/config ===%b\n' "${C_BOLD}" "${C_CYAN}" "${C_RESET}"
    if [ -f "$SSH_CONFIG_FILE" ]; then
        local entries
        entries=$(awk '
            tolower($1) == "host" {
                if (cur_host != "") printf "%s|%s|%s|%s\n", cur_host, cur_hn, cur_user, cur_port
                cur_host=""; cur_hn=""; cur_user=""; cur_port=""
                for (i=2; i<=NF; i++) {
                    if ($i != "*") {
                        cur_host = (cur_host == "" ? $i : cur_host " " $i)
                    }
                }
            }
            cur_host != "" && tolower($1) == "hostname" { cur_hn = $2 }
            cur_host != "" && tolower($1) == "user"     { cur_user = $2 }
            cur_host != "" && tolower($1) == "port"     { cur_port = $2 }
            END {
                if (cur_host != "") printf "%s|%s|%s|%s\n", cur_host, cur_hn, cur_user, cur_port
            }
        ' "$SSH_CONFIG_FILE" 2>/dev/null || true)
        if [ -n "$entries" ]; then
            while IFS='|' read -r h_alias h_hn h_user h_port; do
                [ -z "$h_alias" ] && continue
                local detail=""
                if [ -n "$h_hn" ]; then
                    detail="${h_user:+${h_user}@}${h_hn}${h_port:+:${h_port}}"
                    printf '  • %-20s -> %s\n' "$h_alias" "$detail"
                else
                    printf '  • %s\n' "$h_alias"
                fi
            done <<< "$entries"
        else
            echo "  (Aucun serveur configuré)"
        fi
    else
        echo "  (Fichier ~/.ssh/config absent)"
    fi
}

alias_existe_dans_config() {
    local target_alias="$1"
    [ ! -f "$SSH_CONFIG_FILE" ] && return 1
    awk -v target="$target_alias" '
        BEGIN { found = 1 }
        tolower($1) == "host" {
            for (i = 2; i <= NF; i++) {
                if ($i == target) {
                    found = 0
                    exit
                }
            }
        }
        END { exit found }
    ' "$SSH_CONFIG_FILE"
}

# @description Écriture atomique et sécurisée dans ~/.ssh/config
ajouter_serveur() {
    local alias=""
    local cible=""
    local custom_key=""
    local user_from_flag=""
    local port_from_flag=""
    local has_alias=false
    local has_cible=false

    while [ "$#" -gt 0 ]; do
        case "$1" in
            -i|--key)
                if [ "$#" -ge 2 ]; then custom_key="$2"; shift 2; else shift 1; fi
                ;;
            -i*)
                custom_key="${1#-i}"
                shift
                ;;
            -l|-u|--user)
                if [ "$#" -ge 2 ]; then user_from_flag="$2"; shift 2; else shift 1; fi
                ;;
            -l*)
                user_from_flag="${1#-l}"
                shift
                ;;
            -u*)
                user_from_flag="${1#-u}"
                shift
                ;;
            -p|--port)
                if [ "$#" -ge 2 ]; then port_from_flag="$2"; shift 2; else shift 1; fi
                ;;
            -p*)
                port_from_flag="${1#-p}"
                shift
                ;;
            *)
                if [ "$has_alias" = false ]; then
                    alias="$1"
                    has_alias=true
                elif [ "$has_cible" = false ]; then
                    cible="$1"
                    has_cible=true
                fi
                shift
                ;;
        esac
    done

    # Validation stricte du nom d'alias (Empêche l'injection de directives SSH)
    if [ -z "$alias" ]; then
        log_error "Vous devez spécifier un nom d'alias (ex: kssh --add mon-serveur)"
        return 1
    fi
    if [[ ! "$alias" =~ ^[a-zA-Z0-9._-]+$ ]]; then
        log_error "Alias invalide '$alias'. Seuls les caractères [a-z, A-Z, 0-9, ., _, -] sont autorisés."
        return 1
    fi

    local user="${USER:-$(id -un)}"
    local host=""
    local port="22"

    if [ -n "$cible" ]; then
        # Découpage robuste : IPv6 entre crochets et IPv4 avec port optionnel
        if [[ "$cible" =~ ^([^@]+)@\[([a-fA-F0-9:]+)\](:([^@/]+))?$ ]]; then
            user="${BASH_REMATCH[1]}"; host="${BASH_REMATCH[2]}"
            [ -n "${BASH_REMATCH[4]}" ] && port="${BASH_REMATCH[4]}"
        elif [[ "$cible" =~ ^\[([a-fA-F0-9:]+)\](:([^@/]+))?$ ]]; then
            host="${BASH_REMATCH[1]}"
            [ -n "${BASH_REMATCH[3]}" ] && port="${BASH_REMATCH[3]}"
        elif [[ "$cible" =~ ^([^@]+)@([^:]+)(:([^@/]+))?$ ]]; then
            user="${BASH_REMATCH[1]}"; host="${BASH_REMATCH[2]}"
            [ -n "${BASH_REMATCH[4]}" ] && port="${BASH_REMATCH[4]}"
        elif [[ "$cible" =~ ^([^:]+)(:([^@/]+))?$ ]]; then
            host="${BASH_REMATCH[1]}"
            [ -n "${BASH_REMATCH[3]}" ] && port="${BASH_REMATCH[3]}"
        else
            host="$cible"
        fi
    fi

    # Les drapeaux explicites -l / -u et -p ont la priorité
    [ -n "$user_from_flag" ] && user="$user_from_flag"
    [ -n "$port_from_flag" ] && port="$port_from_flag"

    if [ -z "$host" ]; then
        if [ ! -t 0 ]; then
            log_error "Mode non-interactif : hôte/IP manquant pour '$alias'."
            return 1
        fi
        read -rp "Nom d'hôte ou adresse IP du serveur : " host
        read -rp "Nom d'utilisateur SSH [$user] : " input_user
        [ -n "$input_user" ] && user="$input_user"
        read -rp "Port SSH [$port] : " input_port
        [ -n "$input_port" ] && port="$input_port"
    fi

    # Validation stricte du port (1 à 65535)
    if [[ ! "$port" =~ ^[0-9]+$ ]] || [ "$port" -lt 1 ] || [ "$port" -gt 65535 ]; then
        log_error "Port invalide '$port'. Doit être un entier entre 1 et 65535."
        return 1
    fi

    # Validation stricte de l'utilisateur
    if [[ ! "$user" =~ ^[a-zA-Z0-9._-]+$ ]]; then
        log_error "Nom d'utilisateur invalide '$user'."
        return 1
    fi

    # Validation stricte de l'hôte (interdit wildcards *, ?, %, #, guillemets, espaces et caractères de contrôle)
    if [[ ! "$host" =~ ^[a-zA-Z0-9._:-]+$ ]]; then
        log_error "Nom d'hôte ou adresse IP invalide '$host'."
        return 1
    fi

    if [ -n "$custom_key" ]; then
        if [[ "$custom_key" == *$'\n'* ]] || [[ "$custom_key" == *$'\r'* ]]; then
            log_error "Chemin de clé SSH invalide (caractères de contrôle interdits)."
            return 1
        fi
        custom_key="${custom_key/#\~/$HOME}"
        if [ ! -f "$custom_key" ]; then
            log_warn "Le fichier de clé spécifié '$custom_key' n'existe pas actuellement sur le disque."
        fi
    fi

    # Vérifier dès maintenant si l'alias existe déjà dans ~/.ssh/config avant de modifier KeePassXC
    if alias_existe_dans_config "$alias"; then
        log_warn "L'alias '$alias' existe déjà dans ~/.ssh/config. Paramètres réseau et coffre préservés."
        return 0
    fi

    # ÉTAPE 1 : Détection d'entrée existante ou Enregistrement dans KeePassXC
    if [ -f "$KEEPASS_DB" ] && cmd_exists keepassxc-cli; then
        local ssh_url="ssh://${host}:${port}"
        local master_key=""

        if master_key=$(lire_mot_de_passe_maitre_cache); then
            log_debug "Mot de passe maître chargé depuis le cache mémoire."
        elif [ -t 0 ] && [ -t 1 ]; then
            read -rsp "Mot de passe maître KeePassXC ($KEEPASS_DB) : " master_key
            echo ""
            [ -n "$master_key" ] && sauvegarder_mot_de_passe_maitre_cache "$master_key"
        fi

        # 1.1 Recherche préalable : existe-t-il déjà une entrée exacte pour cette IP / Hôte et cet utilisateur ?
        local existing_entry=""
        local found_list
        found_list=$(kp_search_entries "$host" "$master_key" || true)

        if [ -n "$found_list" ]; then
            while IFS= read -r cand_p; do
                [ -z "$cand_p" ] && continue
                local cand_u cand_url
                cand_url=$(kp_get_attribute "$cand_p" "url" "$master_key" || true)
                url_correspond_cible "$cand_url" "$host" "$port" || continue
                cand_u=$(kp_get_attribute "$cand_p" "username" "$master_key" || true)
                if [ -z "$user" ] || [ "$cand_u" = "$user" ]; then
                    existing_entry="$cand_p"
                    log_success "Entrée existante trouvée dans KeePassXC : '$cand_p' (Utilisateur: $user)."
                    log_info "Réutilisation des identifiants existants sans créer de doublon."
                    break
                fi
            done <<< "$found_list"
        fi

        # 1.2 Si aucune entrée existante n'a été trouvée, on la crée proprement
        if [ -z "$existing_entry" ]; then
            log_info "Création d'une nouvelle entrée dans KeePassXC ($KEEPASS_DB) [URL: $ssh_url]..."
            local kp_base_args=("-u" "$user" "--url" "$ssh_url")
            [ -n "$KEEPASS_KEYFILE" ] && [ -f "$KEEPASS_KEYFILE" ] && kp_base_args+=("-k" "$KEEPASS_KEYFILE")

            local entry_created=false
            local entry_target="$alias"
            local successful_path="$alias"
            if [ -n "$KEEPASS_ROOT_GROUP" ]; then
                # Vérifier si le groupe racine existe dans la base ; si oui, y placer l'entrée
                local ls_args=("-q")
                [ -n "$KEEPASS_KEYFILE" ] && [ -f "$KEEPASS_KEYFILE" ] && ls_args+=("-k" "$KEEPASS_KEYFILE")
                if [ -n "$master_key" ]; then
                    printf '%s\n' "$master_key" | keepassxc-cli ls "${ls_args[@]}" -- "$KEEPASS_DB" "$KEEPASS_ROOT_GROUP" >/dev/null 2>&1 && entry_target="${KEEPASS_ROOT_GROUP}/${alias}"
                elif [ -n "$KEEPASS_KEYFILE" ] && [ -f "$KEEPASS_KEYFILE" ]; then
                    keepassxc-cli ls "${ls_args[@]}" -- "$KEEPASS_DB" "$KEEPASS_ROOT_GROUP" >/dev/null 2>&1 && entry_target="${KEEPASS_ROOT_GROUP}/${alias}"
                fi
            fi
            successful_path="$entry_target"

            if [ -n "$custom_key" ]; then
                # Création de l'entrée pour clé SSH (sans mot de passe d'entrée)
                local kp_add_args=("${kp_base_args[@]}")
                [ -z "$master_key" ] && [ -n "$KEEPASS_KEYFILE" ] && [ -f "$KEEPASS_KEYFILE" ] && kp_add_args+=("--no-password")
                local add_err=""
                if [ -n "$master_key" ]; then
                    if add_err=$(printf '%s\n' "$master_key" | keepassxc-cli add "${kp_add_args[@]}" -- "$KEEPASS_DB" "$entry_target" 2>&1); then
                        entry_created=true
                    else
                        log_debug "keepassxc-cli add ($entry_target) -> $add_err"
                    fi
                elif keepassxc-cli add "${kp_add_args[@]}" -- "$KEEPASS_DB" "$entry_target"; then
                    entry_created=true
                fi
            else
                # Création interactive directe avec mot de passe
                if keepassxc-cli add "${kp_base_args[@]}" -p -- "$KEEPASS_DB" "$entry_target"; then
                    entry_created=true
                fi
            fi

            if [ "$entry_created" = false ]; then
                log_error "Échec de l'enregistrement dans KeePassXC (mot de passe maître erroné ou base verrouillée)."
                log_error "Annulation : le fichier ~/.ssh/config n'a pas été modifié."
                return 1
            fi

            # Si une clé SSH physique existe, on l'attache directement dans l'entrée KeePassXC
            if [ -n "$custom_key" ] && [ -f "$custom_key" ]; then
                local key_filename
                key_filename="$(basename "$custom_key")"
                log_info "Attachement du fichier de clé '$key_filename' à l'entrée KeePassXC..."
                local kp_att_args=("-f")
                [ -n "$KEEPASS_KEYFILE" ] && [ -f "$KEEPASS_KEYFILE" ] && kp_att_args+=("-k" "$KEEPASS_KEYFILE")
                local att_err="" att_ok=true
                if [ -n "$master_key" ]; then
                    if ! att_err=$(printf '%s\n' "$master_key" | keepassxc-cli attachment-import "${kp_att_args[@]}" -- "$KEEPASS_DB" "$successful_path" "$key_filename" "$custom_key" 2>&1); then
                        att_ok=false
                    fi
                elif ! att_err=$(keepassxc-cli attachment-import "${kp_att_args[@]}" -- "$KEEPASS_DB" "$successful_path" "$key_filename" "$custom_key" 2>&1); then
                    att_ok=false
                fi
                if [ "$att_ok" = false ]; then
                    log_warn "Impossible d'attacher la clé '$key_filename' dans KeePassXC : $att_err"
                    custom_key=""
                fi
            fi

            log_success "Entrée '$alias' enregistrée avec succès dans KeePassXC ($successful_path) !"
        fi
    fi

    # ÉTAPE 2 : Écriture atomique et verrouillée dans ~/.ssh/config
    mkdir -p "$SSH_CONFIG_DIR"
    chmod 700 "$SSH_CONFIG_DIR"
    [ ! -f "$SSH_CONFIG_FILE" ] && touch "$SSH_CONFIG_FILE" && chmod 600 "$SSH_CONFIG_FILE"

    local lock_file="${SSH_CONFIG_DIR}/.config.lock"
    (
        if cmd_exists flock; then
            exec 9>"$lock_file"
            chmod 600 "$lock_file" 2>/dev/null || true
            flock -x 9
        fi

        if alias_existe_dans_config "$alias"; then
            log_warn "L'alias '$alias' existe déjà dans ~/.ssh/config. Paramètres réseau existants préservés."
            exit 0
        fi

        log_info "Ajout de l'entrée '$alias' dans $SSH_CONFIG_FILE..."
        TMP_SSH_CONFIG_FILE="$(mktemp "${SSH_CONFIG_DIR}/config.tmp.XXXXXX")"
        chmod 600 "$TMP_SSH_CONFIG_FILE"

        # Copier le contenu actuel
        if [ -s "$SSH_CONFIG_FILE" ]; then
            cat "$SSH_CONFIG_FILE" > "$TMP_SSH_CONFIG_FILE"
            # S'assurer d'un saut de ligne final propre
            if [ -n "$(tail -c 1 "$TMP_SSH_CONFIG_FILE" 2>/dev/null)" ]; then
                echo "" >> "$TMP_SSH_CONFIG_FILE"
            fi
        fi

        # Ajouter le nouveau bloc Host
        {
            echo "Host $alias"
            echo "    HostName $host"
            echo "    User $user"
            echo "    Port $port"
            [ -n "$custom_key" ] && echo "    IdentityFile $custom_key"
            echo ""
        } >> "$TMP_SSH_CONFIG_FILE"

        # Remplacement atomique
        mv -f "$TMP_SSH_CONFIG_FILE" "$SSH_CONFIG_FILE"
        TMP_SSH_CONFIG_FILE=""
        chmod 600 "$SSH_CONFIG_FILE"
    )

    if [ -n "$custom_key" ]; then
        log_success "Serveur configuré avec clé SSH (authentification par clé). Connexion : ${C_CYAN}kssh $alias${C_RESET}"
    else
        log_success "Serveur configuré avec mot de passe KeePassXC. Connexion : ${C_CYAN}kssh $alias${C_RESET}"
    fi
    return 0
}

# ==============================================================================
# [08] PARSER D'ARGUMENTS OPENSSH & RÉSOLUTION NATIVE
# ==============================================================================

# @description Analyse exhaustive des options OpenSSH (y compris options groupées -4p 2222 / -Xp2222)
extraire_cible_ssh() {
    TARGET_HOST=""
    USER_FLAG=""
    HAS_CLI_KEY=false
    CLI_SSH_OPTIONS=()

    local opt_with_arg="bBcDeEFIJLmOoPpQRSWwli"

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --)
                shift
                if [ -z "$TARGET_HOST" ] && [ "$#" -gt 0 ]; then
                    TARGET_HOST="$1"
                    shift
                fi
                break
                ;;
            -[!-]*)
                local flags="${1:1}"
                local idx=0 len=${#flags} consumed_arg=false
                while [ "$idx" -lt "$len" ]; do
                    local ch="${flags:$idx:1}"
                    local rest="${flags:$((idx + 1))}"
                    if [[ "$opt_with_arg" == *"$ch"* ]]; then
                        [ "$ch" = "i" ] && HAS_CLI_KEY=true
                        if [ -n "$rest" ]; then
                            [ "$ch" = "l" ] && USER_FLAG="$rest"
                            CLI_SSH_OPTIONS+=("$1")
                            shift 1
                        elif [ "$#" -ge 2 ]; then
                            [ "$ch" = "l" ] && USER_FLAG="$2"
                            CLI_SSH_OPTIONS+=("$1" "$2")
                            shift 2
                        else
                            CLI_SSH_OPTIONS+=("$1")
                            shift 1
                        fi
                        consumed_arg=true
                        break
                    fi
                    idx=$((idx + 1))
                done
                if [ "$consumed_arg" = false ]; then
                    CLI_SSH_OPTIONS+=("$1")
                    shift 1
                fi
                ;;
            -*)
                CLI_SSH_OPTIONS+=("$1")
                shift
                ;;
            *)
                if [ -z "$TARGET_HOST" ]; then
                    TARGET_HOST="$1"
                    shift
                    # Dès que l'hôte cible est atteint, les arguments suivants constituent la commande distante
                    break
                fi
                ;;
        esac
    done
}

# ==============================================================================
# [09] ORCHESTRATEUR D'EXÉCUTION PRINCIPAL
# ==============================================================================

executer_connexion_ssh() {
    # 1. Vérification de l'existence du client OpenSSH
    if [ -z "$REAL_SSH" ] || [ ! -x "$REAL_SSH" ]; then
        log_error "Client OpenSSH introuvable sur votre système."
        log_error "Veuillez installer OpenSSH via votre gestionnaire de paquets (ou lancer 'kssh --install')."
        return 1
    fi

    # 2. Traitement des arguments de debug
    local filtered_args=()
    for arg in "$@"; do
        if [ "$arg" = "--debug" ]; then
            DEBUG_MODE=true
        else
            filtered_args+=("$arg")
        fi
    done
    set -- "${filtered_args[@]}"

    # 3. Routage des commandes de gestion kssh
    case "${1:-}" in
        --help|-h)            afficher_aide; return 0 ;;
        --version|-v)         echo "kssh"; return 0 ;;
        --list)               lister_serveurs; return 0 ;;
        --lock|--clear-cache) vider_cache_memoire; return 0 ;;
        --agent)
            local agent_rc=0
            detecter_agent_ssh_kpxc || agent_rc=$?
            if [ "$agent_rc" -eq 0 ]; then
                log_success "Agent SSH KeePassXC détecté et actif (Socket: $SSH_AUTH_SOCK)."
                ssh-add -l
            elif [ "$agent_rc" -eq 2 ]; then
                log_info "Agent SSH standard actif (Socket: $SSH_AUTH_SOCK — socket non spécifique à KeePassXC)."
                ssh-add -l
            else
                log_warn "Aucun Agent SSH KeePassXC actif détecté (Vérifier: KeePassXC > Outils > Paramètres > Agent SSH)."
            fi
            return 0
            ;;
        --install)
            shift
            local auto_y=false
            [ "${1:-}" = "--yes" ] || [ "${1:-}" = "-y" ] && auto_y=true
            executer_installation_explicite "$auto_y"
            return $?
            ;;
        --add)
            shift
            ajouter_serveur "$@"
            return $?
            ;;
    esac

    # 4. Extraction transparente de la cible et des options CLI
    TARGET_HOST=""
    USER_FLAG=""
    HAS_CLI_KEY=false
    CLI_SSH_OPTIONS=()
    extraire_cible_ssh "$@"

    log_debug "TARGET_HOST='$TARGET_HOST', USER_FLAG='$USER_FLAG', HAS_CLI_KEY='$HAS_CLI_KEY'"

    # Si aucun hôte n'est détecté (ex: ssh -V ou options seules), passage direct à OpenSSH
    if [ -z "$TARGET_HOST" ]; then
        exec "$REAL_SSH" "$@"
    fi

    # 5. Résolution native OpenSSH via `ssh -G` avec transmission de TOUTES les options CLI
    RESOLVED_USER=""
    RESOLVED_HOST="$TARGET_HOST"
    RESOLVED_PORT="22"

    local ssh_dump=""
    if ssh_dump=$("$REAL_SSH" -G "${CLI_SSH_OPTIONS[@]}" -- "$TARGET_HOST" 2>&1); then
        RESOLVED_USER=$(awk '/^user / {print $2; exit}' <<< "$ssh_dump")
        RESOLVED_HOST=$(awk '/^hostname / {print $2; exit}' <<< "$ssh_dump")
        RESOLVED_PORT=$(awk '/^port / {print $2; exit}' <<< "$ssh_dump")
        [ -z "$RESOLVED_PORT" ] && RESOLVED_PORT="22"
    else
        log_debug "ssh -G a échoué pour '$TARGET_HOST' : $ssh_dump"
        if [[ "$TARGET_HOST" =~ ^([^@]+)@(.*)$ ]]; then
            RESOLVED_USER="${BASH_REMATCH[1]}"
            RESOLVED_HOST="${BASH_REMATCH[2]}"
        fi
    fi
    [ -n "$USER_FLAG" ] && RESOLVED_USER="$USER_FLAG"

    # Si une clé SSH explicite a été passée en ligne de commande (-i), OpenSSH gère nativement
    if [ "$HAS_CLI_KEY" = "true" ]; then
        log_debug "Délégation native à OpenSSH (Option -i explicite fournie)."
        exec "$REAL_SSH" "$@"
    fi

    # Si un socket ControlMaster actif existe déjà pour cette cible, délégation immédiate
    if "$REAL_SSH" -O check "${CLI_SSH_OPTIONS[@]}" -- "$TARGET_HOST" >/dev/null 2>&1; then
        log_debug "Socket ControlMaster actif détecté : délégation directe à OpenSSH."
        exec "$REAL_SSH" "$@"
    fi

    # Si ~/.ssh/config configure une clé dédiée (hors clés par défaut OpenSSH) existante sur disque, délégation native
    if [ -n "$ssh_dump" ]; then
        while IFS= read -r id_line; do
            local id_path="${id_line#identityfile }"
            id_path="${id_path/#\~/$HOME}"
            case "$(basename "$id_path")" in
                id_rsa|id_dsa|id_ecdsa|id_ecdsa_sk|id_ed25519|id_ed25519_sk|id_xmss) continue ;;
            esac
            if [ -f "$id_path" ]; then
                log_debug "Identité SSH dédiée configurée dans ~/.ssh/config ($id_path) : délégation à OpenSSH."
                exec "$REAL_SSH" "$@"
            fi
        done < <(grep '^identityfile ' <<< "$ssh_dump" || true)
    fi

    # Détection de l'agent SSH natif KeePassXC si SSH_AUTH_SOCK n'est pas encore exposé
    detecter_agent_ssh_kpxc >/dev/null 2>&1 || true

    # Détection de l'environnement interactif
    local is_interactive=false
    if [ -t 0 ] && [ -t 1 ]; then
        is_interactive=true
    fi

    # Si en mode non-interactif et que des identités sont chargées dans ssh-agent (ex: git clone, git push, rsync, scripts),
    # délégation directe à OpenSSH sans interroger KeePassXC
    if [ "$is_interactive" = "false" ] && cmd_exists ssh-add && ssh-add -l >/dev/null 2>&1; then
        log_debug "Mode non-interactif avec agent SSH actif : délégation directe à OpenSSH."
        exec "$REAL_SSH" "$@"
    fi

    # 6. Recherche ciblée du mot de passe ou de la clé attachée dans KeePassXC
    PASSWORD=""
    EXTRACTED_KEY_FILE=""

    if [ -f "$KEEPASS_DB" ] && cmd_exists keepassxc-cli; then
        local candidates=(
            "${TARGET_HOST}"
            "${RESOLVED_HOST}"
            "${RESOLVED_USER}@${RESOLVED_HOST}"
            "${KEEPASS_ROOT_GROUP}/${TARGET_HOST}"
            "${KEEPASS_ROOT_GROUP}/SSH/${TARGET_HOST}"
            "SSH/${TARGET_HOST}"
            "${KEEPASS_ROOT_GROUP}/${RESOLVED_USER}@${RESOLVED_HOST}"
            "${KEEPASS_ROOT_GROUP}/${RESOLVED_HOST}"
        )

        local master_key=""
        if master_key=$(lire_mot_de_passe_maitre_cache); then
            log_debug "Mot de passe maître chargé depuis le cache mémoire."
        elif [ "$is_interactive" = "true" ]; then
            read -rsp "Mot de passe maître KeePassXC ($KEEPASS_DB) : " master_key
            echo ""
            [ -n "$master_key" ] && sauvegarder_mot_de_passe_maitre_cache "$master_key"
        fi

        # Si en mode non-interactif et pas de mot de passe maître en cache (ni keyfile), délégation directe à OpenSSH
        if [ "$is_interactive" = "false" ] && [ -z "$master_key" ] && { [ -z "$KEEPASS_KEYFILE" ] || [ ! -f "$KEEPASS_KEYFILE" ]; }; then
            log_debug "Mode non-interactif sans cache KeePassXC : délégation directe à OpenSSH."
            exec "$REAL_SSH" "$@"
        fi

        # 6.1 Recherche directe par chemins d'alias (priorité clé SSH attachée > mot de passe)
        for cand in "${candidates[@]}"; do
            [ -z "$cand" ] && continue
            log_debug "Tentative de récupération directe sur : $cand"

            # Vérifier d'abord si l'entrée contient une clé SSH en pièce jointe
            local attachments=""
            attachments=$(kp_get_attachments "$cand" "$master_key" || true)
            if [ -n "$attachments" ]; then
                local first_att
                first_att=$(head -n 1 <<< "$attachments")
                if [ -n "$first_att" ]; then
                    EXTRACTED_KEY_FILE=$(creer_fichier_cle_temporaire) || EXTRACTED_KEY_FILE=""
                    if [ -n "$EXTRACTED_KEY_FILE" ] && kp_export_attachment "$cand" "$first_att" "$EXTRACTED_KEY_FILE" "$master_key"; then
                        log_debug "Clé SSH '$first_att' extraite depuis KeePassXC ($cand)"
                        break
                    fi
                    [ -n "$EXTRACTED_KEY_FILE" ] && rm -f "$EXTRACTED_KEY_FILE" 2>/dev/null || true
                    EXTRACTED_KEY_FILE=""
                fi
            fi

            # Sinon vérifier si l'entrée contient un mot de passe
            PASSWORD=$(kp_get_attribute "$cand" "password" "$master_key" || true)
            if [ -n "$PASSWORD" ]; then
                log_debug "Mot de passe trouvé pour le candidat : $cand"
                break
            fi
        done

        # 6.2 Recherche exacte par URL (ssh://<IP>[:port]) et nom d'utilisateur si non trouvé
        if [ -z "$PASSWORD" ] && [ -z "$EXTRACTED_KEY_FILE" ]; then
            log_debug "Recherche par URL 'ssh://${RESOLVED_HOST}:${RESOLVED_PORT}' et utilisateur '${RESOLVED_USER}'..."
            local found_entries=""
            found_entries=$(kp_search_entries "${RESOLVED_HOST}" "$master_key" || true)
            if [ -n "$found_entries" ]; then
                while IFS= read -r entry_p; do
                    [ -z "$entry_p" ] && continue
                    # Vérifier l'URL exacte (hôte + port éventuel) pour éviter toute fuite cross-host
                    local entry_url=""
                    entry_url=$(kp_get_attribute "$entry_p" "url" "$master_key" || true)
                    url_correspond_cible "$entry_url" "$RESOLVED_HOST" "$RESOLVED_PORT" || continue

                    # Vérifier l'utilisateur
                    local entry_user=""
                    entry_user=$(kp_get_attribute "$entry_p" "username" "$master_key" || true)
                    if [ -z "$RESOLVED_USER" ] || [ "$entry_user" = "$RESOLVED_USER" ]; then
                        # Priorité aux pièces jointes (clé SSH)
                        local atts=""
                        atts=$(kp_get_attachments "$entry_p" "$master_key" || true)
                        if [ -n "$atts" ]; then
                            local f_att
                            f_att=$(head -n 1 <<< "$atts")
                            EXTRACTED_KEY_FILE=$(creer_fichier_cle_temporaire) || EXTRACTED_KEY_FILE=""
                            if [ -n "$EXTRACTED_KEY_FILE" ] && kp_export_attachment "$entry_p" "$f_att" "$EXTRACTED_KEY_FILE" "$master_key"; then
                                log_debug "Clé SSH '$f_att' trouvée via URL exacte dans $entry_p"
                                break
                            fi
                            [ -n "$EXTRACTED_KEY_FILE" ] && rm -f "$EXTRACTED_KEY_FILE" 2>/dev/null || true
                            EXTRACTED_KEY_FILE=""
                        fi

                        # Sinon mot de passe
                        local entry_pwd=""
                        entry_pwd=$(kp_get_attribute "$entry_p" "password" "$master_key" || true)
                        if [ -n "$entry_pwd" ]; then
                            PASSWORD="$entry_pwd"
                            log_debug "Mot de passe trouvé via URL exacte dans $entry_p"
                            break
                        fi
                    fi
                done <<< "$found_entries"
            fi
        fi

        unset master_key
    fi

    # 7. Connexion automatique via Clé SSH attachée ou Mot de passe sécurisé (FD 3)
    if [ -n "$EXTRACTED_KEY_FILE" ] && [ -f "$EXTRACTED_KEY_FILE" ]; then
        # Si un agent SSH est actif et accepte la clé sans passphrase interactive, la charger en mémoire et purger le fichier immédiatement
        if cmd_exists ssh-add && [ -n "${SSH_AUTH_SOCK:-}" ] && [ -S "${SSH_AUTH_SOCK:-}" ]; then
            if ssh-add -t 60 "$EXTRACTED_KEY_FILE" </dev/null >/dev/null 2>&1; then
                rm -f "$EXTRACTED_KEY_FILE" 2>/dev/null || true
                unset EXTRACTED_KEY_FILE
                log_success "Clé SSH chargée en mémoire dans l'agent SSH (TTL 60s) pour '$TARGET_HOST'. Connexion..."
                exec "$REAL_SSH" "$@"
            fi
        fi

        log_success "Clé SSH extraite depuis KeePassXC pour '$TARGET_HOST'. Connexion..."
        local ssh_status=0
        "$REAL_SSH" -i "$EXTRACTED_KEY_FILE" "$@" || ssh_status=$?
        rm -f "$EXTRACTED_KEY_FILE" 2>/dev/null || true
        unset EXTRACTED_KEY_FILE
        return "$ssh_status"
    fi

    if [ -n "$PASSWORD" ] && cmd_exists sshpass; then
        log_success "Mot de passe récupéré depuis KeePassXC pour '$TARGET_HOST'. Connexion..."
        # Injection via tube anonyme FD 3 (sans fichier temporaire /tmp/sh-thd.* ni exposition cmdline)
        exec sshpass -d 3 "$REAL_SSH" "$@" 3< <(printf '%s' "$PASSWORD")
    fi

    # 8. Fallback standard
    # Si des clés sont chargées dans l'agent SSH (ssh-add -l) ou en environnement non-interactif
    if [ ! -t 0 ] || [ ! -t 1 ] || (cmd_exists ssh-add && ssh-add -l >/dev/null 2>&1); then
        exec "$REAL_SSH" "$@"
    fi

    # Mode interactif : Proposer l'enregistrement du serveur inconnu (sans récursion infinie)
    if [ "${KSSH_NO_RECURSE:-0}" != "1" ]; then
        log_warn "Aucun mot de passe ni clé trouvés dans KeePassXC pour '$TARGET_HOST'."
        read -rp "Voulez-vous enregistrer ce serveur maintenant dans KeePassXC ? [O/n] : " choix
        if [[ "$choix" =~ ^[oOyY]?$ ]]; then
            if ajouter_serveur "$TARGET_HOST"; then
                log_info "Connexion en cours..."
                KSSH_NO_RECURSE=1 executer_connexion_ssh "$@"
                return $?
            fi
        fi
    fi

    log_info "Connexion SSH standard..."
    exec "$REAL_SSH" "$@"
}

# ==============================================================================
# POINT D'ENTRÉE DU SCRIPT
# ==============================================================================
executer_connexion_ssh "$@"
