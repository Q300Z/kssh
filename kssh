# Variable globale du mode debug
DEBUG_MODE=false

# Rétablit l'écho du terminal et purge les variables sensibles en cas de sortie
nettoyage_securite() {
    local exit_code=$?
    trap - EXIT INT TERM HUP
    # Rétablir l'affichage terminal
    stty echo 2>/dev/null || true
    # Nettoyer les clés SSH temporaires extraites de KeePassXC
    [ -n "${EXTRACTED_KEY_FILE:-}" ] && [ -f "$EXTRACTED_KEY_FILE" ] && rm -f "$EXTRACTED_KEY_FILE" 2>/dev/null || true
    # Purge des variables contenant potentiellement des secrets
    unset PASSWORD ssh_password MASTER_PASSWORD_CACHE master_key 2>/dev/null || true
    exit "$exit_code"
}
trap nettoyage_securite EXIT INT TERM HUP

