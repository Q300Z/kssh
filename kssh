cmd_exists() { command -v "$1" >/dev/null 2>&1; }

# ==============================================================================
# [04] GESTION DES DÉPENDANCES LOGICIELLES (TABLEAUX NATIFS)
# ==============================================================================

detecter_gestionnaire_paquets() {
    if cmd_exists pacman; then echo "pacman"
    elif cmd_exists apt-get; then echo "apt"
    elif cmd_exists dnf; then echo "dnf"
    elif cmd_exists zypper; then echo "zypper"
    elif cmd_exists brew; then echo "brew"
    else echo "unknown"; fi
}

installer_dependances_systeme() {
    local auto_yes="${1:-false}"
    local paquets_manquants=()
    cmd_exists ssh          || paquets_manquants+=("openssh")
    cmd_exists sshpass      || paquets_manquants+=("sshpass")
    cmd_exists keepassxc-cli || paquets_manquants+=("keepassxc")

    if [ ${#paquets_manquants[@]} -eq 0 ]; then
        log_success "Toutes les dépendances logicielles sont déjà installées."
        return 0
    fi

    local pkg_mgr
    pkg_mgr=$(detecter_gestionnaire_paquets)
    local cmd_array=()

    case "$pkg_mgr" in
        pacman) cmd_array=("pacman" "-S" "--needed" "--noconfirm" "${paquets_manquants[@]}") ;;
        apt)    cmd_array=("apt-get" "install" "-y" "${paquets_manquants[@]}") ;;
        dnf)    cmd_array=("dnf" "install" "-y" "${paquets_manquants[@]}") ;;
        zypper) cmd_array=("zypper" "install" "-y" "${paquets_manquants[@]}") ;;
        brew)   cmd_array=("brew" "install" "${paquets_manquants[@]}") ;;
        *)
            log_error "Gestionnaire de paquets inconnu. Veuillez installer manuellement : ${paquets_manquants[*]}"
            return 1
            ;;
    esac

    if [ "$EUID" -eq 0 ]; then
        if [ "$auto_yes" != "true" ] && [ -t 0 ]; then
            read -rp "Confirmer l'installation de [${paquets_manquants[*]}] ? [O/n] : " rep
            [[ ! "$rep" =~ ^[oOyY]?$ ]] && { log_warn "Installation annulée."; return 1; }
        fi
        log_info "Installation des paquets..."
        [ "$pkg_mgr" = "apt" ] && apt-get update
        "${cmd_array[@]}"
        log_success "Installation des dépendances terminée avec succès."
    else
        log_warn "Dépendance(s) manquante(s) : ${C_BOLD}${paquets_manquants[*]}${C_RESET}"
        log_info "Pour installer les paquets requis, exécutez :"
        if [ "$pkg_mgr" = "apt" ]; then
            printf '\n  %b%bsudo apt-get update && sudo %s%b\n\n' "${C_BOLD}" "${C_GREEN}" "${cmd_array[*]}" "${C_RESET}"
        else
            printf '\n  %b%bsudo %s%b\n\n' "${C_BOLD}" "${C_GREEN}" "${cmd_array[*]}" "${C_RESET}"
        fi
        log_warn "Relancez ensuite kssh une fois les paquets installés."
        return 1
    fi
}

# ==============================================================================
# [05] INSTALLATION EXPLICITE & CONFIGURATION SHELL
# ==============================================================================

injecter_config_sans_ecraser() {
    local fichier_rc="$1"
    local ligne="$2"
    local commentaire="$3"

    [ ! -f "$fichier_rc" ] && touch "$fichier_rc"

    if ! grep -Fqs "$ligne" "$fichier_rc"; then
        {
            echo ""
            [ -n "$commentaire" ] && echo "$commentaire"
            echo "$ligne"
        } >> "$fichier_rc"
        log_info "Configuration ajoutée à $(basename "$fichier_rc") : $ligne"
    fi
}

installer_autocompletion() {
    mkdir -p "$BASH_COMPLETION_DIR" "$ZSH_COMPLETION_DIR"

    # Autocomplétion Bash dédiée à kssh (sans écraser la complétion native de ssh)
    cat << 'EOF' > "${BASH_COMPLETION_DIR}/kssh"
_kssh_complete() {
    local cur prev words cword
    _init_completion || return

    local options="--add --list --lock --agent --install --debug --version --help -h -v"
    local hosts=""

    local ssh_cfg="${SSH_CONFIG_FILE:-$HOME/.ssh/config}"
    if [[ -f "$ssh_cfg" ]]; then
        hosts=$(awk 'tolower($1) == "host" { for (i=2; i<=NF; i++) if ($i != "*") print $i }' "$ssh_cfg" 2>/dev/null)
    fi

    if [[ "$cur" == -* ]]; then
        COMPREPLY=( $(compgen -W "$options" -- "$cur") )
        return 0
    fi

    COMPREPLY=( $(compgen -W "$hosts $options" -- "$cur") )
}
complete -F _kssh_complete kssh
EOF
    log_success "Autocomplétion Bash installée (${BASH_COMPLETION_DIR}/kssh)."

    # Autocomplétion Zsh dédiée à kssh (syntaxe _describe conforme)
    cat << 'EOF' > "${ZSH_COMPLETION_DIR}/_kssh"
#compdef kssh
_kssh() {
    local -a options hosts
    options=(
        '--add[Ajouter un serveur à ~/.ssh/config et KeePassXC]'
        '--list[Lister les serveurs configurés]'
        '--lock[Vider le cache mémoire de session]'
        '--agent[Afficher l'\''état de l'\''agent SSH KeePassXC]'
        '--install[Installer/Vérifier les dépendances]'
        '--debug[Activer le mode diagnostic]'
        '--version[Afficher la version]'
        '--help[Afficher l'\''aide]'
    )
    local ssh_cfg="${SSH_CONFIG_FILE:-$HOME/.ssh/config}"
    if [[ -f "$ssh_cfg" ]]; then
        hosts=(${(f)"$(awk 'tolower($1) == "host" { for (i=2; i<=NF; i++) if ($i != "*") print $i }' "$ssh_cfg" 2>/dev/null)"})
    fi
    _describe -t hosts 'serveurs' hosts
    _describe -t options 'options' options
}
_kssh "$@"
EOF
    log_success "Autocomplétion Zsh installée (${ZSH_COMPLETION_DIR}/_kssh)."
}

executer_installation_explicite() {
    local auto_yes="${1:-false}"
    log_info "=== Initialisation de l'installation de kssh ==="

    local deps_ok=true
    if ! installer_dependances_systeme "$auto_yes"; then
        deps_ok=false
    fi

    mkdir -p "$INSTALL_DIR" "$SSH_CONFIG_DIR"
    chmod 700 "$SSH_CONFIG_DIR"

    if [ ! -f "$SSH_CONFIG_FILE" ]; then
        touch "$SSH_CONFIG_FILE"
        chmod 600 "$SSH_CONFIG_FILE"
    fi

    local script_source
    script_source="$(realpath "$0" 2>/dev/null || readlink -f "$0")"

    if [ "$script_source" != "$TARGET_BIN" ]; then
        log_info "Copie du binaire dans $TARGET_BIN..."
        cp "$script_source" "$TARGET_BIN"
        chmod 755 "$TARGET_BIN"
        log_success "Binaire installé dans $TARGET_BIN"
    else
        chmod 755 "$TARGET_BIN"
    fi

    installer_autocompletion

    local export_path='export PATH="$HOME/.local/bin:$PATH"'
    local alias_ssh="alias ssh='kssh'"
    local source_bash_comp="[[ -f ~/.local/share/bash-completion/completions/kssh ]] && source ~/.local/share/bash-completion/completions/kssh"

    if [ -f "$HOME/.bashrc" ] || [ -f "$HOME/.bash_profile" ]; then
        local bash_target="$HOME/.bashrc"
        [ ! -f "$bash_target" ] && bash_target="$HOME/.bash_profile"
        injecter_config_sans_ecraser "$bash_target" "$export_path" "# Support de ~/.local/bin pour kssh"
        injecter_config_sans_ecraser "$bash_target" "$alias_ssh" "# Alias SSH intelligent vers kssh"
        injecter_config_sans_ecraser "$bash_target" "$source_bash_comp" "# Chargement autocomplétion kssh"
    fi

    if [ -f "$HOME/.zshrc" ]; then
        injecter_config_sans_ecraser "$HOME/.zshrc" "$export_path" "# Support de ~/.local/bin pour kssh"
        injecter_config_sans_ecraser "$HOME/.zshrc" "$alias_ssh" "# Alias SSH intelligent vers kssh"
        injecter_config_sans_ecraser "$HOME/.zshrc" 'fpath=(~/.local/share/zsh/site-functions $fpath)' "# FPath pour autocomplétion kssh"
    fi

    if [ "$deps_ok" = true ]; then
        log_success "=== Installation terminée avec succès ! ==="
        return 0
    else
        log_warn "=== Configuration installée, mais des dépendances système restent manquantes. ==="
        return 1
    fi
}

