# PROJET       : kssh (KeePassSSH)
# AUTEUR       : Q300Z (https://qalpuch.cc)
# REPO         : git@github.com:Q300Z/kssh.git
# DESCRIPTION  : Orchestrateur et gestionnaire de connexions OpenSSH automatisé
#                avec stockage chiffré KeePassXC et injection sécurisée SSHPass.
#
# ARCHITECTURE & FLUX D'EXÉCUTION :
#   1. CLI Input ──► 2. Parser OpenSSH conforme (table stricte d'options)
#   3. Résolution native (ssh -G "$@") ──► 4. Détection Clé SSH active
#   5. Recherche Mot de passe dans KeePassXC (Requête exacte sans heuristique)
#   6. Injection anonyme via File Descriptor (FD 3) ──► 7. Session SSH
#
# SÉCURITÉ & GARANTIES TECHNIQUES :
#   - Injection FD 3 : Pas d'exposition du secret dans /proc/$PID/cmdline.
#   - Hygiène Mémoire : Nettoyage immédiat (unset) des variables sensibles.
#   - Atomicité : Écriture atomique et verrouillée dans ~/.ssh/config.
#   - Validation Stricte : Contrôle strict (regex/plage) des alias, ports et hôtes.
#   - Non-Intrusif : Installation explicite (kssh --install), pas de root silencieux.
#
# LICENCE      : MIT
# ==============================================================================

set -eo pipefail

# ==============================================================================
# [01] HYGIÈNE DU TERMINAL, SÉCURITÉ & NETTOYAGE MÉMOIRE
# ==============================================================================

# Variable globale du mode debug
DEBUG_MODE=false
TMP_SSH_CONFIG_FILE=""

# Rétablit l'écho du terminal et purge les variables sensibles en cas de sortie
nettoyage_securite() {
    local exit_code=$?
    trap - EXIT INT TERM HUP
    # Rétablir l'affichage terminal
    stty echo 2>/dev/null || true
    # Nettoyer les clés SSH temporaires extraites de KeePassXC et fichiers temp ~/.ssh/config
    [ -n "${EXTRACTED_KEY_FILE:-}" ] && [ -f "$EXTRACTED_KEY_FILE" ] && rm -f "$EXTRACTED_KEY_FILE" 2>/dev/null || true
    [ -n "${TMP_SSH_CONFIG_FILE:-}" ] && [ -f "$TMP_SSH_CONFIG_FILE" ] && rm -f "$TMP_SSH_CONFIG_FILE" 2>/dev/null || true
    # Purge des variables contenant potentiellement des secrets
    unset PASSWORD master_key master_pwd entry_pwd 2>/dev/null || true
    exit "$exit_code"
}
trap nettoyage_securite EXIT INT TERM HUP

# ==============================================================================
# [02] CONSTANTES, CHEMINS XDG & CONFIGURATION GLOBALE
# ==============================================================================

# Répertoires utilisateurs standardisés (XDG)
INSTALL_DIR="${XDG_BIN_HOME:-$HOME/.local/bin}"
TARGET_BIN="${INSTALL_DIR}/kssh"
SSH_CONFIG_DIR="${SSH_CONFIG_DIR:-$HOME/.ssh}"
SSH_CONFIG_FILE="${SSH_CONFIG_FILE:-$SSH_CONFIG_DIR/config}"
BASH_COMPLETION_DIR="${BASH_COMPLETION_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/bash-completion/completions}"
ZSH_COMPLETION_DIR="${ZSH_COMPLETION_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/zsh/site-functions}"

# Base, Keyfile et Groupe Racine KeePassXC (Surchargeables via variables d'environnement)
KEEPASS_DB="${KEEPASS_DB:-$HOME/Database.kdbx}"
KEEPASS_KEYFILE="${KEEPASS_KEYFILE:-}"
KEEPASS_ROOT_GROUP="${KEEPASS_ROOT_GROUP:-Database}"

# Configuration du Cache Mémoire de Session (RAM volatile /dev/shm ou XDG_RUNTIME_DIR uniquement, sans fallback /tmp)
KSSH_CACHE_ENABLED="${KSSH_CACHE_ENABLED:-true}"
KSSH_CACHE_TTL="${KSSH_CACHE_TTL:-7200}" # 2 heures en secondes par défaut
if [ -z "${KSSH_CACHE_DIR:-}" ]; then
    if [ -d /dev/shm ] && [ -w /dev/shm ]; then
        KSSH_CACHE_DIR="/dev/shm/kssh_cache_${UID:-$(id -u)}"
    elif [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -d "$XDG_RUNTIME_DIR" ] && [ -w "$XDG_RUNTIME_DIR" ]; then
        KSSH_CACHE_DIR="${XDG_RUNTIME_DIR}/kssh_cache_${UID:-$(id -u)}"
    else
        KSSH_CACHE_DIR=""
    fi
fi
KSSH_CACHE_FILE="${KSSH_CACHE_DIR:+${KSSH_CACHE_DIR}/master.key}"

# Fonctions de gestion du cache mémoire de session (anti-TOCTOU & anti-symlink)
lire_mot_de_passe_maitre_cache() {
    [ "$KSSH_CACHE_ENABLED" != "true" ] && return 1
    [ -z "$KSSH_CACHE_DIR" ] || [ -z "$KSSH_CACHE_FILE" ] && return 1
    [ -L "$KSSH_CACHE_DIR" ] || [ ! -d "$KSSH_CACHE_DIR" ] && return 1
    [ -L "$KSSH_CACHE_FILE" ] || [ ! -f "$KSSH_CACHE_FILE" ] && return 1

    local cur_uid dir_uid file_uid dir_perms perms
    cur_uid="${UID:-$(id -u)}"
    dir_uid=$(stat -c %u "$KSSH_CACHE_DIR" 2>/dev/null || stat -f %u "$KSSH_CACHE_DIR" 2>/dev/null || echo "")
    file_uid=$(stat -c %u "$KSSH_CACHE_FILE" 2>/dev/null || stat -f %u "$KSSH_CACHE_FILE" 2>/dev/null || echo "")
    if [ "$dir_uid" != "$cur_uid" ] || [ "$file_uid" != "$cur_uid" ]; then
        log_warn "Propriétaire invalide sur le cache mémoire. Cache ignoré."
        return 1
    fi

    dir_perms=$(stat -c %a "$KSSH_CACHE_DIR" 2>/dev/null || stat -f %Lp "$KSSH_CACHE_DIR" 2>/dev/null || echo "")
    if [ -n "$dir_perms" ] && [ "$dir_perms" != "700" ]; then
        log_warn "Permissions non sécurisées ($dir_perms) sur le répertoire de cache. Invalidation préventive."
        rm -rf "$KSSH_CACHE_DIR" 2>/dev/null || true
        return 1
    fi

    perms=$(stat -c %a "$KSSH_CACHE_FILE" 2>/dev/null || stat -f %Lp "$KSSH_CACHE_FILE" 2>/dev/null || echo "")
    if [ -n "$perms" ] && [ "$perms" != "600" ] && [ "$perms" != "400" ]; then
        log_warn "Permissions non sécurisées ($perms) sur le cache mémoire. Invalidation préventive."
        rm -rf "$KSSH_CACHE_DIR" 2>/dev/null || true
        return 1
    fi

    local now mtime age
    now=$(date +%s)
    mtime=$(stat -c %Y "$KSSH_CACHE_FILE" 2>/dev/null || stat -f %m "$KSSH_CACHE_FILE" 2>/dev/null || echo 0)
    age=$((now - mtime))

    if [ "$age" -gt "$KSSH_CACHE_TTL" ]; then
        rm -f "$KSSH_CACHE_FILE" 2>/dev/null || true
        return 1
    fi

    cat "$KSSH_CACHE_FILE" 2>/dev/null
    return 0
}

sauvegarder_mot_de_passe_maitre_cache() {
    local pwd="$1"
    [ "$KSSH_CACHE_ENABLED" != "true" ] && return 0
    [ -z "$pwd" ] && return 0
    [ -z "$KSSH_CACHE_DIR" ] || [ -z "$KSSH_CACHE_FILE" ] && return 0
    [ -L "$KSSH_CACHE_DIR" ] && { log_warn "Répertoire cache suspect (lien symbolique). Cache désactivé."; return 1; }

    (
        umask 077
        mkdir -p "$KSSH_CACHE_DIR"
        chmod 700 "$KSSH_CACHE_DIR"
        local cur_uid dir_uid
        cur_uid="${UID:-$(id -u)}"
        dir_uid=$(stat -c %u "$KSSH_CACHE_DIR" 2>/dev/null || stat -f %u "$KSSH_CACHE_DIR" 2>/dev/null || echo "")
        [ "$dir_uid" != "$cur_uid" ] && exit 1

        local tmp_cache
        tmp_cache=$(mktemp "${KSSH_CACHE_DIR}/.master.XXXXXX")
        printf '%s' "$pwd" > "$tmp_cache"
        mv -f "$tmp_cache" "$KSSH_CACHE_FILE"
    )
}

vider_cache_memoire() {
    if [ -n "$KSSH_CACHE_DIR" ] && [ ! -L "$KSSH_CACHE_DIR" ]; then
        rm -rf "$KSSH_CACHE_DIR" 2>/dev/null || true
    fi
    log_success "Cache mémoire de session vidé avec succès. La base est reverrouillée."
}

# Détection de l'Agent SSH natif de KeePassXC (Option 3)
# Retourne 0 si socket KeePassXC détecté, 2 si autre agent SSH générique actif, 1 sinon
detecter_agent_ssh_kpxc() {
    local orig_sock="${SSH_AUTH_SOCK:-}"
    local kpxc_socks=(
        "/run/user/${UID:-$(id -u)}/kpxc_ssh_agent.sock"
        "${XDG_RUNTIME_DIR:-/run/user/${UID:-$(id -u)}}/kpxc_ssh_agent.sock"
        "$HOME/.ssh/kpxc_ssh_agent.sock"
    )
    if [ -n "$orig_sock" ] && [ -S "$orig_sock" ] && [[ "$orig_sock" == *kpxc_ssh_agent* ]]; then
        if ssh-add -l >/dev/null 2>&1; then
            return 0
        fi
    fi
    for sock in "${kpxc_socks[@]}"; do
        if [ -S "$sock" ]; then
            export SSH_AUTH_SOCK="$sock"
            if ssh-add -l >/dev/null 2>&1; then
                log_debug "Agent SSH KeePassXC actif détecté sur $sock"
                return 0
            fi
        fi
    done
    if [ -n "$orig_sock" ] && [ -S "$orig_sock" ]; then
        export SSH_AUTH_SOCK="$orig_sock"
        if ssh-add -l >/dev/null 2>&1; then
            return 2
        fi
    fi
    [ -n "$orig_sock" ] && export SSH_AUTH_SOCK="$orig_sock" || unset SSH_AUTH_SOCK
    return 1
}

# Résolution explicite et sécurisée du vrai binaire OpenSSH
trouver_vrai_binaire_ssh() {
    local self_real target_real cand_real
    self_real="$(realpath "$0" 2>/dev/null || readlink -f "$0" 2>/dev/null || echo "$0")"
    target_real="$(realpath "$TARGET_BIN" 2>/dev/null || readlink -f "$TARGET_BIN" 2>/dev/null || echo "$TARGET_BIN")"

    if [ -n "${OPENSSH_BIN:-}" ] && [ -x "$OPENSSH_BIN" ]; then
        cand_real="$(realpath "$OPENSSH_BIN" 2>/dev/null || readlink -f "$OPENSSH_BIN" 2>/dev/null || echo "$OPENSSH_BIN")"
        if [ "$cand_real" != "$self_real" ] && [ "$cand_real" != "$target_real" ]; then
            echo "$OPENSSH_BIN"
            return 0
        fi
    fi

    local chemins=("/usr/bin/ssh" "/bin/ssh" "/usr/local/bin/ssh" "/opt/homebrew/bin/ssh")
    for binaire in "${chemins[@]}"; do
        if [ -x "$binaire" ]; then
            cand_real="$(realpath "$binaire" 2>/dev/null || readlink -f "$binaire" 2>/dev/null || echo "$binaire")"
            if [ "$cand_real" != "$self_real" ] && [ "$cand_real" != "$target_real" ]; then
                echo "$binaire"
                return 0
            fi
        fi
    done

    local ssh_path
    ssh_path="$(type -P ssh 2>/dev/null || true)"
    if [ -n "$ssh_path" ] && [ -x "$ssh_path" ]; then
        cand_real="$(realpath "$ssh_path" 2>/dev/null || readlink -f "$ssh_path" 2>/dev/null || echo "$ssh_path")"
        if [ "$cand_real" != "$self_real" ] && [ "$cand_real" != "$target_real" ]; then
            echo "$ssh_path"
            return 0
        fi
    fi
    return 1
}

REAL_SSH="$(trouver_vrai_binaire_ssh || true)"

