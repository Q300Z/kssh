# Configuration du Cache Mémoire de Session (Option 1 : RAM volatile /dev/shm avec expiration)
KSSH_CACHE_ENABLED="${KSSH_CACHE_ENABLED:-true}"
KSSH_CACHE_TTL="${KSSH_CACHE_TTL:-7200}" # 2 heures en secondes par défaut
KSSH_CACHE_DIR="${KSSH_CACHE_DIR:-$([ -d /dev/shm ] && echo "/dev/shm/kssh_cache_${UID:-$(id -u)}" || echo "${XDG_RUNTIME_DIR:-/tmp}/kssh_cache_${UID:-$(id -u)}")}"
KSSH_CACHE_FILE="${KSSH_CACHE_DIR}/master.key"

# Fonctions de gestion du cache mémoire de session
lire_mot_de_passe_maitre_cache() {
    [ "$KSSH_CACHE_ENABLED" != "true" ] && return 1
    [ ! -f "$KSSH_CACHE_FILE" ] && return 1

    # Vérification stricte des permissions (seul le propriétaire doit pouvoir lire)
    local perms
    perms=$(stat -c %a "$KSSH_CACHE_FILE" 2>/dev/null || stat -f %Lp "$KSSH_CACHE_FILE" 2>/dev/null || echo "")
    if [ -n "$perms" ] && [ "$perms" != "600" ] && [ "$perms" != "400" ]; then
        log_warn "Permissions non sécurisées ($perms) sur le cache mémoire. Invalidation préventive."
        rm -rf "$KSSH_CACHE_DIR" 2>/dev/null || true
        return 1
    fi

    local now mtime age
    now=$(date +%s)
    mtime=$(stat -c %Y "$KSSH_CACHE_FILE" 2>/dev/null || stat -f %m "$KSSH_CACHE_FILE" 2>/dev/null || echo 0)
    age=$((now - mtime))

    if [ "$age" -gt "$KSSH_CACHE_TTL" ]; then
        rm -f "$KSSH_CACHE_FILE" 2>/dev/null || true
        return 1
    fi

    cat "$KSSH_CACHE_FILE" 2>/dev/null
    return 0
}

sauvegarder_mot_de_passe_maitre_cache() {
    local pwd="$1"
    [ "$KSSH_CACHE_ENABLED" != "true" ] && return 0
    [ -z "$pwd" ] && return 0

    mkdir -p "$KSSH_CACHE_DIR" && chmod 700 "$KSSH_CACHE_DIR"
    (
        umask 077
        printf '%s' "$pwd" > "$KSSH_CACHE_FILE"
    )
    chmod 600 "$KSSH_CACHE_FILE"
}

vider_cache_memoire() {
    rm -rf "$KSSH_CACHE_DIR" 2>/dev/null || true
    log_success "Cache mémoire de session vidé avec succès. La base est reverrouillée."
}

# Détection de l'Agent SSH natif de KeePassXC (Option 3)
detecter_agent_ssh_kpxc() {
    if [ -n "${SSH_AUTH_SOCK:-}" ] && [ -S "$SSH_AUTH_SOCK" ]; then
        if ssh-add -l >/dev/null 2>&1; then
            return 0
        fi
    fi
    local orig_sock="${SSH_AUTH_SOCK:-}"
    local kpxc_socks=(
        "/run/user/${UID:-$(id -u)}/kpxc_ssh_agent.sock"
        "${XDG_RUNTIME_DIR:-/run/user/${UID:-$(id -u)}}/kpxc_ssh_agent.sock"
        "$HOME/.ssh/kpxc_ssh_agent.sock"
    )
    for sock in "${kpxc_socks[@]}"; do
        if [ -S "$sock" ]; then
            export SSH_AUTH_SOCK="$sock"
            if ssh-add -l >/dev/null 2>&1; then
                log_debug "Agent SSH KeePassXC actif détecté sur $sock"
                return 0
            fi
        fi
    done
    [ -n "$orig_sock" ] && export SSH_AUTH_SOCK="$orig_sock" || unset SSH_AUTH_SOCK
    return 1
}

# Résolution explicite et sécurisée du vrai binaire OpenSSH
trouver_vrai_binaire_ssh() {
    if [ -n "${OPENSSH_BIN:-}" ] && [ -x "$OPENSSH_BIN" ]; then
        echo "$OPENSSH_BIN"
        return 0
    fi
    local chemins=("/usr/bin/ssh" "/bin/ssh" "/usr/local/bin/ssh" "/opt/homebrew/bin/ssh")
    for binaire in "${chemins[@]}"; do
        if [ -x "$binaire" ] && [ "$binaire" != "$TARGET_BIN" ]; then
            echo "$binaire"
            return 0
        fi
    done
    local ssh_path
    ssh_path="$(type -P ssh 2>/dev/null || true)"
    if [ -n "$ssh_path" ] && [ "$ssh_path" != "$TARGET_BIN" ] && [ -x "$ssh_path" ]; then
        echo "$ssh_path"
        return 0
    fi
    return 1
}

REAL_SSH="$(trouver_vrai_binaire_ssh || true)"

